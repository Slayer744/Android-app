<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgCartProduct"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <ImageButton
            android:id="@+id/btnDeleteCart"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#D62828"
            android:contentDescription="Delete" />

        <TextView
            android:id="@+id/txtCartName"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgCartProduct"
            android:layout_marginStart="12dp"
            android:text="Product name"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#10233D" />

        <TextView
            android:id="@+id/txtCartUnitPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtCartName"
            android:layout_toEndOf="@id/imgCartProduct"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="1500 DA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0057B8" />

        <LinearLayout
            android:id="@+id/cartQtyRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtCartUnitPrice"
            android:layout_toEndOf="@id/imgCartProduct"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnMinusCart"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="-"
                android:textSize="18sp"
                android:textColor="#0057B8"
                android:backgroundTint="#E0EFFF" />

            <TextView
                android:id="@+id/txtCartQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#10233D" />

            <Button
                android:id="@+id/btnPlusCart"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+"
                android:textSize="16sp"
                android:textColor="#00A86B"
                android:backgroundTint="#E0F7EF" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCartTotalItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@id/cartQtyRow"
            android:text="1500 DA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#10233D" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>