<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:layout_margin="6dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/imgFavoriteProduct"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:background="#F5F5F5" />

        <ImageButton
            android:id="@+id/btnRemoveFavorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_margin="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@android:color/transparent"
            android:tint="#D62828"
            android:contentDescription="Remove favorite" />

        <TextView
            android:id="@+id/txtFavoriteName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/imgFavoriteProduct"
            android:text="Product Name"
            android:textColor="#1A1A2E"
            android:textStyle="bold"
            android:textSize="13sp"
            android:maxLines="2"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtFavoritePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtFavoriteName"
            android:text="0 DA"
            android:textColor="#0057B8"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnFavoriteAddToCart"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_below="@id/txtFavoritePrice"
            android:text="Add to Cart"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00A86B"
            android:layout_marginTop="8dp" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>